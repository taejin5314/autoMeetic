{
  "name": "automeetic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n proxy,vite -c cyan,green \"npm run server\" \"npm run dev:ui\"",
    "dev:ui": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "probe:realtime": "node scripts/probe-openai-realtime.js",
    "simulate:whiteboard": "node scripts/simulate-whiteboard-agent.js",
    "smoke:store-cache": "node scripts/smoke-test-store-cache.js",
    "build:moonshine-sidecars": "node scripts/build-moonshine-sidecars.js",
    "prepare:release-packages": "node scripts/prepare-release-packages.js",
    "preview": "vite preview",
    "server": "node server/proxy.mjs",
    "start": "npm run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@excalidraw/excalidraw": "^0.18.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ws": "^8.20.0"
  },
  "optionalDependencies": {
    "@automeetic/moonshine-darwin-arm64": "0.0.59",
    "@automeetic/moonshine-darwin-x64": "0.0.59"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
